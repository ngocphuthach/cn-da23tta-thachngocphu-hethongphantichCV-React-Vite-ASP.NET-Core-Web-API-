# ===================================================
#  .env.example - File MAU. Copy thanh .env roi dien gia tri that.
#               File .env da duoc .gitignore -> se KHONG bi commit.
#  Cach dung:  Copy-Item .env.example .env
# ===================================================

# ---------------- SQL Server (docker-compose) ----------------
# Mat khau tai khoan 'sa'. Yeu cau cua SQL Server:
#   >= 8 ky tu, co CHU HOA + chu thuong + SO + ky tu dac biet.
# GIA TRI DUOI DAY CHI LA MAU -> phai doi truoc khi dung that.
SA_PASSWORD=YourStrong!Passw0rd_CHANGE_ME
# Developer = ban mien phi day du tinh nang (dung cho do an)
MSSQL_PID=Developer
# Cong mo ra ngoai may host
MSSQL_PORT=1433

# ---------------- Backend (ASP.NET Core Web API) ----------------
ASPNETCORE_ENVIRONMENT=Development
# Chuoi ket noi toi SQL Server trong docker (port 1433).
# Luu y: dung dau ',' phan cong (host,port) chu khong dung ':' nhu SQL Server.
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=CvAdvisorDb;User Id=sa;Password=YourStrong!Passw0rd_CHANGE_ME;TrustServerCertificate=True;Encrypt=False

# ---------------- AI Service (Python FastAPI) ----------------
# Gia tri mau; thay bang endpoint, model va key duoc nha cung cap cap.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://tokenharbor.ai/v1
LLM_MODEL=dien-key-o-day
LLM_API_KEY=dien-key-o-day
# Tuy chon: neu dat, client phai gui header X-Internal-Key
INTERNAL_API_KEY=your-internal-api-key-here
AI_SERVICE_PORT=8000

# ---------------- Frontend (React + Vite) ----------------
# Bien VITE_* duoc Vite dua vao bundle luc build (dung cho goi API)
VITE_API_BASE_URL=http://localhost:5000

# ASP.NET Core JWT signing key placeholder; replace only in local secrets/environment

# Matching key for ASP.NET Core -> AI Service; set the real value in User Secrets/environment

JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGIN=http://localhost:5173
