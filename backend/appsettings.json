{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "CvAdvisor.Api",
    "Audience": "CvAdvisor.Frontend",
    "ExpirationMinutes": 60
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000/",
    "TimeoutSeconds": 120
  },
  "Storage": {
    "CvRoot": ""
  },
  "RateLimiting": {
    "CvAnalysis": {
      "PermitLimit": 5,
      "WindowMinutes": 15
    },
    "ManualCv": {
      "PermitLimit": 10,
      "WindowMinutes": 15
    }
  }
}
